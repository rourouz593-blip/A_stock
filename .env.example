# 复制为 .env 使用（.env 已在 .gitignore 中）
#
# 本文件会被 scripts/env.py 自动加载，**不需要 source .env**。
# 真实环境变量优先于这里的值，所以 CI 里可以直接用环境变量覆盖。
# 留空的键会被跳过（等于没填），不会写成空字符串。

# ─────────────────────────────────────────────────────────
# 账户（章节七算风险必需）
# ─────────────────────────────────────────────────────────
# 账户总资产，单位：元。
# 缺了它，风险章节只能给比例、给不出金额——
# 绝不允许拿持仓市值当账户总资产估算。
ASTOCK_ACCOUNT_EQUITY=

# ─────────────────────────────────────────────────────────
# 数据源：AKShare（免费、无需 token）
# 所以这里没有 API KEY 要填。
# 但 akshare 背后是第三方网页接口，会限流，下面几个参数用来控节奏。
# ─────────────────────────────────────────────────────────
ASTOCK_MAX_RETRY=3
ASTOCK_RETRY_SLEEP=1.5

# 网络疑难开关（平时不用设，本项目会自动降级并打印提示）
#   连不上时先跑 python tools/net_check.py，它会告诉你该开哪个
# ASTOCK_DIRECT=1        # 强制绕开代理（东财新浪都是境内站，直连通常更快）
# ASTOCK_IPV4_ONLY=1     # 强制只走 IPv4（网络的 IPv6 出口坏掉时用）
# ASTOCK_UA=...          # 覆盖默认浏览器 User-Agent
# ASTOCK_CACHE_TTL_MIN=30  # 缓存有效期（分钟）；实时快照放久了会让情绪判断跑偏

# ─────────────────────────────────────────────────────────
# 模型 API（只有 api 模式需要；用 astock next/done 的话完全不用填）
#
# 先 cp config/models.yaml.example config/models.yaml，在里面选 provider，
# 然后把对应的 key 填到这里。一次完整复盘约 2.2 万输入 token。
# ─────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 本地 Ollama / vLLM 不需要 key

# ─────────────────────────────────────────────────────────
# 路径
# ─────────────────────────────────────────────────────────
ASTOCK_DATA_DIR=./data
ASTOCK_CACHE_DIR=./workspace/cache
ASTOCK_LOG_LEVEL=INFO
