# 复制为 .env 使用（.env 已在 .gitignore 中）
#
# 本文件会被 scripts/env.py 自动加载，**不需要 source .env**。
# 真实环境变量优先于这里的值，所以 CI 里可以直接用环境变量覆盖。
# 留空的键会被跳过（等于没填），不会写成空字符串。

# ─────────────────────────────────────────────────────────
# 账户（章节七算风险必需）
# ─────────────────────────────────────────────────────────
# 账户总资产，单位：元。
# 缺了它，风险章节只能给比例、给不出金额——
# 绝不允许拿持仓市值当账户总资产估算。
ASTOCK_ACCOUNT_EQUITY=

# ─────────────────────────────────────────────────────────
# 数据源：AKShare（免费、无需 token）
# 所以这里没有 API KEY 要填。
# 但 akshare 背后是第三方网页接口，会限流，下面几个参数用来控节奏。
# ─────────────────────────────────────────────────────────
ASTOCK_MAX_RETRY=3
ASTOCK_RETRY_SLEEP=1.5

# 网络疑难开关（平时不用设，本项目会自动降级并打印提示）
#   连不上时先跑 python tools/net_check.py，它会告诉你该开哪个
# ASTOCK_DIRECT=1        # 强制绕开代理（东财新浪都是境内站，直连通常更快）
# ASTOCK_IPV4_ONLY=1     # 强制只走 IPv4（网络的 IPv6 出口坏掉时用）
# ASTOCK_UA=...          # 覆盖默认浏览器 User-Agent
# ASTOCK_CACHE_TTL_MIN=30  # 缓存有效期（分钟）；实时快照放久了会让情绪判断跑偏
# ASTOCK_CONNECT_TIMEOUT=10  # 连接超时（秒）。akshare 自己不带 timeout，会无限挂起
# ASTOCK_READ_TIMEOUT=30     # 读取超时（秒）
# ASTOCK_MIN_INTERVAL=0.4    # 两次请求的最小间隔（非东财源）
# ASTOCK_EM_MIN_INTERVAL=1.0 # 东财单独加严：实测 >5次/秒 触发风控，别调小
# ASTOCK_DROP_RETRY=2        # 被限流时最多重试几次（死磕不如快点退到备用源）
# ASTOCK_FAILS_TO_TRIP=3     # 一个域名连续被拒几次后进入冷却
# ASTOCK_COOLDOWN_MIN=10     # 冷却多少分钟（期间一次请求都不发）
# ASTOCK_IGNORE_COOLDOWN=1   # 强行忽略冷却（慎用：硬打会扩大封禁范围）
# ── 每日请求预算（比熔断更早的一道闸）────────────────────────────
# 熔断管"被拒之后别再打"，预算管"每个都成功但数量失控"——后者才是被封的开始。
# 一次正常复盘约 30–50 个请求。看用量：python tools/astock.py budget
# ASTOCK_MAX_REQUESTS=300    # 全部域名合计，每天上限；超了直接 blocked，不重试
# ASTOCK_MAX_PER_HOST=120    # 单个域名每天上限；防止把额度全砸在一个源上

# ── 本地行情仓库（真正把请求量降下来的那一半）────────────────────
# 已收盘的交易日不会再变，所以只取一次、永久存本地。
# 看有什么：python tools/astock.py store
# ASTOCK_HISTORY_DB=./workspace/history.sqlite
#     放到网络盘/同步盘上 SQLite 会报 disk I/O error，那就换个本地路径
# ASTOCK_CLOSE_GUARD=15:05   # 几点之后才认为当天数据定稿、可以入库

# ── 数据源优先级 ────────────────────────────────────────────────
# 正常改 config/datasources.yaml；下面这些是临时覆盖，排障和教学演示用
# ASTOCK_PROVIDER_SPOT=eastmoney,tencent      # 快照改走东财
# ASTOCK_PROVIDER_INDEX_DAILY=sina            # 指数日线改走新浪

# ─────────────────────────────────────────────────────────
# 模型 API（只有 api 模式需要；用 astock next/done 的话完全不用填）
#
# 先 cp config/models.yaml.example config/models.yaml，在里面选 provider，
# 然后把对应的 key 填到这里。一次完整复盘约 2.2 万输入 token。
# ─────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 本地 Ollama / vLLM 不需要 key

# ─────────────────────────────────────────────────────────
# 路径
# ─────────────────────────────────────────────────────────
ASTOCK_DATA_DIR=./data
ASTOCK_CACHE_DIR=./workspace/cache
ASTOCK_LOG_LEVEL=INFO
