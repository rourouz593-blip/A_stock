# ─────────────────────────────────────────────────────────
# 数据源凭证（TODO(datasource): 数据源确定后按需填写）
# 复制本文件为 .env，.env 已在 .gitignore 中
# ─────────────────────────────────────────────────────────

# Tushare Pro token
TUSHARE_TOKEN=

# 新闻 / 公告数据源
NEWS_API_KEY=
NEWS_API_BASE=

# 情绪数据源（雪球 / 股吧 / 财经媒体）
SENTIMENT_API_KEY=

# ─────────────────────────────────────────────────────────
# 运行时
# ─────────────────────────────────────────────────────────
# 数据落盘根目录
ASTOCK_DATA_DIR=./data
# 运行产物根目录
ASTOCK_WORKSPACE_DIR=./workspace
# 日志级别 DEBUG / INFO / WARNING
ASTOCK_LOG_LEVEL=INFO
