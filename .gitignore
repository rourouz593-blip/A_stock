# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 环境与凭证
.env
.env.local

# 运行时产物：示例 run 保留，真实 run 不入库
workspace/runs/*
!workspace/runs/2026-08-28_example/
workspace/cache/

# 个人配置：持仓与阈值不入库，只保留 example
config/positions.yaml
config/positions.yaml.bak
config/thresholds.yaml

# 持仓截图含真实账户信息，绝不入库
*.png
*.jpg
*.jpeg
*.webp
!docs/**/*.png

# 数据落盘
data/

# 记忆层的运行流水（按需决定是否入库）
memory/runs/*.json

# 测试缓存
.pytest_cache/
.coverage

# 编辑器
.DS_Store
.idea/
.vscode/
