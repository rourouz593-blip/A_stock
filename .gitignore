# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 环境与凭证
.env
.env.local

# 运行时产物：示例 run 保留，真实 run 不入库
workspace/runs/*
!workspace/runs/2026-08-28_example/
workspace/cache/
workspace/history.sqlite      # 本地行情仓库；删了会自动重建，只是要多花几个请求

# 个人配置：持仓与阈值不入库，只保留 example
config/positions.yaml
config/positions.yaml.bak
config/thresholds.yaml
config/models.yaml

# 持仓截图含真实账户信息，绝不入库
*.png
*.jpg
*.jpeg
*.webp
!docs/**/*.png

# 数据落盘
data/

# 记忆层的运行流水（含真实持仓与盈亏，不入库）
memory/runs/*.json
memory/positions_history.jsonl

# 测试缓存
.pytest_cache/
.coverage

# 编辑器
.DS_Store
.idea/
.vscode/
