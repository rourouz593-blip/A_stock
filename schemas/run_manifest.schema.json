{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_manifest.schema.json",
  "title": "运行清单",
  "description": "orchestrator 产出，记录一次分析运行的范围与各步状态",
  "type": "object",
  "required": ["run_id", "created_at", "as_of", "targets", "status", "steps"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "description": "格式 YYYY-MM-DD_<slug>"},
    "created_at": {"type": "string", "description": "ISO8601 UTC"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "分析基准日"},
    "targets": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "pattern": "^\\d{6}\\.(SH|SZ|BJ)$"}
    },
    "lookback_days": {"type": "integer", "minimum": 1},
    "status": {"enum": ["pending", "running", "completed", "partial", "failed"]},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "status"],
        "additionalProperties": false,
        "properties": {
          "agent": {"type": "string"},
          "status": {"enum": ["pending", "running", "ok", "blocked", "failed", "skipped"]},
          "artifact": {"type": ["string", "null"], "description": "产物相对路径"},
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]},
          "attempts": {"type": "integer", "minimum": 0},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
