{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fundamental.schema.json",
  "title": "基本面分析结论",
  "type": "object",
  "required": ["run_id", "target", "status", "verdict", "dimensions", "evidence", "confidence", "caveats"],
  "properties": {
    "run_id": {"type": "string"},
    "target": {"type": "string"},
    "status": {"$ref": "_common.defs.json#/$defs/status"},
    "blocked_reason": {"type": ["string", "null"], "description": "status=blocked 时必填"},
    "verdict": {"enum": ["positive", "neutral", "negative", "unknown"]},
    "dimensions": {
      "type": "array",
      "description": "分析维度。维度枚举与打分口径 TODO(strategy)",
      "items": {
        "type": "object",
        "required": ["name", "reading"],
        "properties": {
          "name": {"enum": ["profit_quality", "asset_quality", "returns", "growth", "solvency", "valuation"]},
          "reading": {"type": "string", "description": "定性判断"},
          "score": {"type": ["number", "null"], "description": "TODO(strategy): 打分体系未定，暂为 null"},
          "confidence": {"$ref": "_common.defs.json#/$defs/confidence"},
          "evidence": {"type": "array", "items": {"$ref": "_common.defs.json#/$defs/evidence"}}
        }
      }
    },
    "key_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description"],
        "properties": {
          "type": {"type": "string", "description": "如 pledge / unlock / goodwill / regulatory / st_risk"},
          "description": {"type": "string"},
          "severity": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "_common.defs.json#/$defs/evidence"}},
    "confidence": {"$ref": "_common.defs.json#/$defs/confidence"},
    "caveats": {"$ref": "_common.defs.json#/$defs/caveats"}
  }
}
