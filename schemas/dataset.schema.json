{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset.schema.json",
  "title": "数据集",
  "description": "data-engineer 产出，本次 run 唯一的事实来源。所有分析 agent 只能引用这里的数字",
  "type": "object",
  "required": ["run_id", "as_of", "mode", "adjust_mode", "data_source", "blocks", "quality_flags"],
  "properties": {
    "run_id": {"type": "string"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "mode": {"enum": ["close", "premarket", "positions", "weekly"]},
    "generated_at": {"type": "string"},
    "adjust_mode": {"enum": ["qfq", "hfq", "none"]},
    "data_source": {"type": "string"},
    "blocks": {
      "type": "object",
      "propertyNames": {
        "enum": ["calendar", "index_spot", "index_intraday", "index_hist", "breadth",
                 "limit_pool", "sectors", "sector_flow", "holdings", "news",
                 "announcements", "northbound"]
      },
      "additionalProperties": {"$ref": "#/$defs/block"}
    },
    "derived": {
      "type": "object",
      "description": "由 data_engineer/scripts/clean/derive.py 算出的派生量，保证可复现",
      "properties": {
        "two_market_amount": {"type": ["object", "null"]}
      }
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block", "level", "message"],
        "properties": {
          "block": {"type": "string"},
          "level": {"enum": ["info", "warning", "error"]},
          "message": {"type": "string"},
          "affected_range": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["status", "provenance"],
      "properties": {
        "status": {"enum": ["ok", "degraded", "missing"]},
        "rows": {"type": ["integer", "null"]},
        "path": {"type": ["string", "null"], "description": "明细 CSV 路径"},
        "inline": {"description": "小体量摘要，直接内联供 agent 读取"},
        "provenance": {
          "type": "object",
          "required": ["source", "fetched_at"],
          "properties": {
            "source": {"type": "string", "description": "如 akshare.stock_zt_pool_em"},
            "fetched_at": {"type": "string"},
            "params": {"type": ["object", "null"]},
            "unit": {"type": ["string", "null"]},
            "fallback_from": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
