{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentiment.schema.json",
  "title": "情绪面分析结论",
  "type": "object",
  "required": ["run_id", "target", "status", "window", "sentiment_score", "attention_score", "events", "confidence", "caveats"],
  "properties": {
    "run_id": {"type": "string"},
    "target": {"type": "string"},
    "status": {"$ref": "_common.defs.json#/$defs/status"},
    "blocked_reason": {"type": ["string", "null"]},
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}}
    },
    "sentiment_score": {
      "type": ["number", "null"],
      "description": "情绪方向。取值范围与计算口径 TODO(strategy)，未定前可为 null 并用 direction 表达"
    },
    "direction": {"enum": ["positive", "neutral", "negative", "mixed", "unknown"]},
    "attention_score": {
      "type": ["number", "null"],
      "description": "关注热度。与情绪方向是两个独立维度，不得混用"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "direction", "certainty", "source_tier", "timestamp", "summary"],
        "properties": {
          "type": {"type": "string", "description": "事件类型枚举 TODO(strategy)"},
          "direction": {"enum": ["positive", "negative", "neutral"]},
          "certainty": {"enum": ["fact", "reported", "rumor"], "description": "rumor 永远不得升级为 fact"},
          "source_tier": {"enum": ["T1", "T2", "T3", "T4"], "description": "T1 交易所/监管 … T4 社交平台"},
          "source_url": {"type": ["string", "null"]},
          "timestamp": {"type": "string"},
          "summary": {"type": "string"},
          "horizon": {"enum": ["short", "medium", "long", "unknown"]}
        }
      }
    },
    "divergences": {
      "type": "array",
      "description": "舆情方向与资金方向不一致之处",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {"type": "string"},
          "evidence": {"type": "array", "items": {"$ref": "_common.defs.json#/$defs/evidence"}}
        }
      }
    },
    "confidence": {"$ref": "_common.defs.json#/$defs/confidence"},
    "caveats": {"$ref": "_common.defs.json#/$defs/caveats"}
  }
}
