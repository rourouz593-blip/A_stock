{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technical.schema.json",
  "title": "技术面分析结论",
  "type": "object",
  "required": ["run_id", "target", "status", "adjust_mode", "trend_state", "indicators", "confidence", "caveats"],
  "properties": {
    "run_id": {"type": "string"},
    "target": {"type": "string"},
    "status": {"$ref": "_common.defs.json#/$defs/status"},
    "blocked_reason": {"type": ["string", "null"]},
    "adjust_mode": {"enum": ["qfq", "hfq", "none"], "description": "必须与 dataset 一致，用于自证口径"},
    "sample": {
      "type": "object",
      "description": "样本情况，用于判断长周期指标是否可信",
      "properties": {
        "bars": {"type": "integer"},
        "start": {"type": "string"},
        "end": {"type": "string"},
        "suspended_days": {"type": "integer"},
        "limit_days": {"type": "integer", "description": "涨跌停天数，信号可能被截断"}
      }
    },
    "trend_state": {
      "type": "object",
      "required": ["direction", "strength"],
      "properties": {
        "direction": {"enum": ["up", "down", "range", "unclear"]},
        "strength": {"enum": ["strong", "moderate", "weak"]},
        "timeframe": {"type": "string", "description": "如 daily / weekly"}
      }
    },
    "indicators": {
      "type": "array",
      "description": "只允许出现 skills/technical-indicators 白名单中的指标",
      "items": {
        "type": "object",
        "required": ["name", "params", "value", "reading"],
        "properties": {
          "name": {"type": "string"},
          "params": {"type": "object"},
          "value": {},
          "reading": {"type": "string"},
          "caveat": {"type": ["string", "null"]}
        }
      }
    },
    "key_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "price", "basis"],
        "properties": {
          "type": {"enum": ["support", "resistance"]},
          "price": {"type": "number"},
          "basis": {"type": "string", "description": "可复现的判定依据，禁止写“看图判断”"},
          "strength": {"enum": ["strong", "moderate", "weak"]}
        }
      }
    },
    "volatility": {
      "type": ["object", "null"],
      "properties": {"level": {"enum": ["high", "normal", "low"]}, "state": {"enum": ["expanding", "contracting", "stable"]}}
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "direction"],
        "properties": {
          "name": {"type": "string"},
          "direction": {"enum": ["bullish", "bearish", "neutral"]},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "confidence": {"$ref": "_common.defs.json#/$defs/confidence"},
    "caveats": {"$ref": "_common.defs.json#/$defs/caveats"}
  }
}
